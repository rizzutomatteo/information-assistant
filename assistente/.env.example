# Copia questo file in .env e cambia solo ciò che serve: ogni valore ha già un default.
# ASSISTENTE_… vale per tutto l'assistente, VOCE_… solo per il canale voce.

# ============================== L'assistente =================================================

# --- Dove sta l'API dell'assistente, il RAG (la stessa per chat e voce) ----------------------
# Per le prove: la finta API (comando finta-api). Con l'API vera, il suo indirizzo.
ASSISTENTE_API_URL=http://127.0.0.1:8001

# --- Il server -------------------------------------------------------------------------------
ASSISTENTE_HOST=127.0.0.1
ASSISTENTE_PORTA=8002
# DEBUG per vedere i tempi di ogni passo (mai il testo detto o scritto dall'utente)
ASSISTENTE_LOG=INFO

# --- Documenti e utenti ----------------------------------------------------------------------
# I documenti da leggere nel sito (/documenti): <area>/<nome>.md. Se manca, la cartella
# documenti/ del progetto (nell'immagine Docker è /app/documenti)
# ASSISTENTE_DOCUMENTI=/percorso/assoluto/documenti
# Il file SQLite di utenti e polizze, lo stesso per le due copie del sito (con docker compose:
# /dati/utenti.sqlite, cioè dati/ nel progetto). Se manca, gli utenti stanno in memoria
# ASSISTENTE_UTENTI=/percorso/assoluto/dati/utenti.sqlite
# La password della pagina /a, dove si caricano gli utenti di prova incollando un JSON (con docker
# compose si scrive in AMMINISTRAZIONE_PASSWORD, sotto). Vuota: la pagina non c'è
ASSISTENTE_AMMINISTRAZIONE_PASSWORD=

# --- «Accedi con Google» ---------------------------------------------------------------------
# Il client OAuth (Google Cloud, tipo «Applicazione web», con l'indirizzo del sito tra le origini
# JavaScript autorizzate). Il client ID non è un segreto, il client secret sì (con docker compose
# si scrive in GOOGLE_CLIENT_SECRET, sotto). Vuoti: si entra solo con utente e password.
ASSISTENTE_GOOGLE_CLIENT_ID=
ASSISTENTE_GOOGLE_CLIENT_SECRET=

# ============================== Il canale voce ===============================================

# --- Chiamate dal sito (WebRTC) --------------------------------------------------------------
# Chiamate contemporanee: la CPU è condivisa con OpenSearch, Qwen3 e il resto
VOCE_CHIAMATE_MAX=2
# Server STUN, separati da virgole. Vuoto va bene in rete locale o su Tailscale; da internet
# serve almeno uno STUN, e il TURN per le reti che non lasciano passare l'audio diretto:
# VOCE_ICE=stun:stun.cloudflare.com:3478
VOCE_ICE=
# Il TURN di Cloudflare (Realtime → TURN Server): l'ID della chiave e il suo token. Con docker
# compose si scrivono in CLOUDFLARE_TURN_KEY_ID e CLOUDFLARE_TURN_KEY_TOKEN, sotto. Vuoti: niente TURN
VOCE_TURN_CHIAVE=
VOCE_TURN_TOKEN=
# Dietro una VPN o un firewall con regole sulle porte: gli unici indirizzi da offrire al browser e
# le porte UDP dell'audio (una per chiamata; vanno aperte nelle regole). Vuoti: tutte le
# interfacce, porte casuali.
# VOCE_INDIRIZZI=100.64.0.10
# VOCE_PORTE_UDP=8098-8101
VOCE_INDIRIZZI=
VOCE_PORTE_UDP=

# --- Voce → testo (faster-whisper, sulla CPU) --------------------------------------------
# tiny / base / small / medium. Su 4 core Arm a riposo, per una domanda: base ≈ 1,4 s,
# small ≈ 3,5 s ma sbaglia meno. Il tempo dipende poco dalla lunghezza della frase.
VOCE_WHISPER_MODELLO=small
VOCE_WHISPER_THREAD=4
# Ipotesi valutate insieme: 5 è più preciso di 1 e, su frasi brevi, costa uguale
VOCE_WHISPER_BEAM=5
# Secondi di silenzio dopo cui la frase è finita
VOCE_FINE_FRASE=0.8
# Solo la voce di chi chiama: le frasi di altre persone nella stanza (un'aula, un ufficio) si
# scartano se la loro impronta somiglia a quella di chi chiama meno della soglia (da 0 a 1). Nelle
# prove: tra frasi della stessa persona da 0,55 a 0,95, tra persone diverse quasi sempre sotto 0,5
VOCE_SOLO_CHI_CHIAMA=1
VOCE_SOGLIA_VOCE=0.55
# VOCE_IMPRONTE_CARTELLA=/percorso/assoluto/voce/modelli/impronte
# Whisper su Groq (piano gratuito: 20 richieste al minuto): molto più veloce del modello locale,
# che resta come riserva. L'audio esce dal server: senza chiave si trascrive solo in locale.
# La chiave (console.groq.com, «API Keys») è un segreto: con docker compose si scrive in
# GROQ_API_KEY, sotto.
VOCE_GROQ_CHIAVE=
VOCE_GROQ_MODELLO=whisper-large-v3
# Secondi dopo cui, se Groq non ha risposto, la frase passa al servizio successivo
VOCE_GROQ_ATTESA=2.0
# Azure Speech (piano gratuito F0: 5 ore di audio al mese): con l'audio del telefono capisce
# meglio di Whisper. Serve una risorsa «Speech» sul portale Azure; chiave e area (per esempio
# northeurope) sono segreti come quella di Groq: con docker compose si scrivono in
# AZURE_SPEECH_KEY e AZURE_SPEECH_REGION, sotto.
VOCE_AZURE_CHIAVE=
VOCE_AZURE_AREA=
VOCE_AZURE_ATTESA=2.0
# Chi trascrive, in ordine, per ogni entrata (groq, azure); i servizi senza chiave si saltano e il
# modello locale è sempre l'ultimo
VOCE_TRASCRIZIONE_SITO=groq
VOCE_TRASCRIZIONE_TELEFONO=azure,groq

# --- Testo → voce (Piper) ---------------------------------------------------------------
# Voci italiane: it_IT-paola-medium (donna), it_IT-riccardo-x_low (uomo, più leggera)
VOCE_PIPER_VOCE=it_IT-paola-medium
# La voce delle chiamate in inglese (la bandiera inglese della pagina)
VOCE_PIPER_VOCE_EN=en_GB-cori-medium
# VOCE_PIPER_CARTELLA=/percorso/assoluto/voce/modelli/piper
# 1 normale, 1.1 un po' più lenta
VOCE_RITMO=1.0

# --- Conversazione -----------------------------------------------------------------------
# L'utente può interrompere l'assistente parlandogli sopra
VOCE_INTERRUZIONI=1
# Frasi dette al massimo per risposta (il resto è nella chat)
VOCE_MAX_FRASI=3
# Secondi senza risposta prima di dire «Un attimo, …»
VOCE_ATTESA=1.5
# Secondi di silenzio dopo cui la chiamata si chiude
VOCE_SILENZIO_MAX=180

# ============================== Prove e docker compose =======================================

# --- docker-compose.yml (su qualsiasi macchina) -----------------------------------------------
# La porta del sito sulla macchina (http://localhost:8002). Le altre voci che legge stanno sotto:
# AMMINISTRAZIONE_PASSWORD, GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET, GROQ_API_KEY, e la chiave
# TURN (CLOUDFLARE_TURN_KEY_ID e CLOUDFLARE_TURN_KEY_TOKEN) per le chiamate fuori da Linux
PORTA=8002

# --- Finta API (solo per le prove) -------------------------------------------------------
FINTA_API_PORTA=8001
# Moltiplica le attese simulate dei nodi (0 = nessuna attesa)
FINTA_API_RITARDO=1

# --- Telefono (voce/centralino/; vedi README, «Il numero di telefono») -----------------------
# Lo stesso segreto va al centralino e al server (VOCE_TELEFONO_SEGRETO)
TELEFONO_SEGRETO=
# La password del telefono di prova (utente «prova»), da scrivere nell'app SIP
TELEFONO_PASSWORD_PROVA=
# Il numero vero, con i dati che manda l'operatore dopo l'attivazione
OPERATORE_SERVER=
OPERATORE_UTENTE=
OPERATORE_PASSWORD=
# L'indirizzo pubblico del server (Oracle), per l'audio che arriva dall'operatore
OPERATORE_IP_PUBBLICO=

# --- Accesso con Google ----------------------------------------------------------------------
# Il client OAuth (vedi sopra, ASSISTENTE_GOOGLE_…): il compose li passa al sito
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Pagina /a -------------------------------------------------------------------------------
# La password per caricare gli utenti di prova: il compose la passa alle due copie del sito
AMMINISTRAZIONE_PASSWORD=

# --- Whisper su Groq e Azure Speech -----------------------------------------------------------
# Le chiavi: il compose le passa al server come VOCE_GROQ_CHIAVE, VOCE_AZURE_CHIAVE e
# VOCE_AZURE_AREA
GROQ_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- La copia pubblica del sito (li scrive strumenti/cloudflare_pubblica.py) ------------------
# Il token del tunnel di Cloudflare e la chiave del TURN: il compose li passa a «tunnel» e a
# «pubblica»
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_TOKEN=

# --- La VPS del progetto (docker-compose.vps.yml) ---------------------------------------------
# Con questa riga docker compose usa il file della VPS anche senza -f
# COMPOSE_FILE=docker-compose.vps.yml
# L'indirizzo Tailscale (copia privata e centralino) e quello privato nel cloud (copia pubblica)
IP_TAILNET=
IP_PRIVATO=
# Per strumenti/cloudflare_pubblica.py: l'account Cloudflare, la zona DNS e il nome del sito
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONA=
CLOUDFLARE_NOME=
